# Copy to .streamlit/secrets.toml for local runs, or paste into the
# Streamlit Cloud "Secrets" box. Never commit the real values.

allowed_emails = ["you@gmail.com", "friend@gmail.com"]

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"  # local: http://localhost:8501/oauth2callback
cookie_secret = "long-random-string"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
